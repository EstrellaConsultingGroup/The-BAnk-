# Copy to .env and fill in. Never paste keys into chat; the agent never asks for them.
# .env is gitignored.

COMPOSIO_API_KEY=            # platform.composio.dev -> Settings -> API Keys
APIFY_TOKEN=                 # console.apify.com -> Settings -> Integrations -> Personal API token
UPLOAD_POST_API_KEY=         # app.upload-post.com -> API Keys
UPLOAD_POST_USER=            # the Upload-Post profile name your TikTok is connected to

# Optional
OPENAI_API_KEY=              # thumbnails with gpt-image
GEMINI_API_KEY=              # thumbnails with nano banana pro
TWITCH_CLIENT_ID=            # dev.twitch.tv/console -> Register app (free, better than scraping Twitch clips)
TWITCH_CLIENT_SECRET=

# Optional: pin Composio auth configs instead of auto-discovering them
COMPOSIO_AUTH_CONFIG_YOUTUBE=
COMPOSIO_AUTH_CONFIG_INSTAGRAM=
COMPOSIO_AUTH_CONFIG_APIFY=
